# Be Whole Care — environment variables
#
# NAMES ONLY. Never put a real value in this file: it is committed to git.
# Real values live in Vercel → Settings → Environment Variables, and, for local
# work, in your own .env.local (git-ignored).
#
# With none of these set, `npm run dev` still works: the app uses a local JSON
# datastore and mock payments, calendar and email. See DEPLOY.md for where each
# value comes from.

# --- Required in production -------------------------------------------------
# Supabase transaction-pooler connection string (port 6543).
DATABASE_URL=
# Signs session cookies. Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
SESSION_SECRET=
# The public URL, e.g. https://bewholecare.vercel.app — used in emails and payment redirects.
NEXT_PUBLIC_APP_URL=
# Protects /api/cron/reminders (sent as the x-cron-secret header).
CRON_SECRET=

# --- Email (Resend) -----------------------------------------------------------
RESEND_API_KEY=
# e.g. Be Whole Care <bookings@your-verified-domain>
EMAIL_FROM=
EMAIL_REPLY_TO=

# --- Payments: set PAYMENT_PROVIDER and the matching provider's keys --------
# peach | payfast | yoco (leave empty to use whichever has credentials, or the mock)
PAYMENT_PROVIDER=
PEACH_ENTITY_ID=
PEACH_SECRET_TOKEN=
PEACH_WEBHOOK_SECRET=
# sandbox | live
PEACH_MODE=
PAYFAST_MERCHANT_ID=
PAYFAST_MERCHANT_KEY=
PAYFAST_PASSPHRASE=
# sandbox | live
PAYFAST_MODE=
YOCO_SECRET_KEY=
YOCO_WEBHOOK_SECRET=
# Apple Pay domain association file contents (Peach), if Apple Pay is enabled.
APPLE_PAY_DOMAIN_ASSOCIATION=

# --- Google Calendar sync (optional) -------------------------------------------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
GOOGLE_CALENDAR_ID=

# --- "Continue with Google" sign-in (optional) ----------------------------------
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# --- WhatsApp Cloud API (optional) ------------------------------------------------
WHATSAPP_API_URL=
WHATSAPP_API_TOKEN=

# --- Tuning (optional) ---------------------------------------------------------------
# Max Postgres connections per server instance.
DATABASE_POOL_MAX=

# The helper scripts in scripts/ (check-db.sh, set-password.sh, …) ask for the
# database password at a hidden prompt. Do not store it here.
